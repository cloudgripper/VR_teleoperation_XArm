{
  "name": "Quest VR Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8000, 9090],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "runArgs": [
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--network=host"
  ],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  }
}

